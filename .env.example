NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional server-only local Wan settings; the UI can also save them.
# Never use NEXT_PUBLIC_ for provider keys.
# CLIPMINT_DATA_DIR=D:/ClipmintData
# FAL_KEY=
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Vercel Wan mode is selected automatically on Vercel. Connect a PRIVATE Blob
# store in Storage and redeploy; this server-only token is needed for uploads.
# BLOB_READ_WRITE_TOKEN=
# CLIPMINT_BLOB_PREFIX=clipmint/wan/v1
# CLIPMINT_STORAGE=vercel-blob
